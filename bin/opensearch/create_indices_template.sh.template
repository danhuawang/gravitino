#!/bin/bash

#
# Copyright 2024 Datastrato Inc.
#

VERSION=$1
OPENSEARCH_URL=$2
USERNAME=$3
PASSWORD=$4

# Reported to the caller while OpenSearch is still untouched, so that it can tell a rejected
# version apart from a half-installed one.
REJECTED=2

# Prepare credentials for curl
CREDENTIALS="-u $USERNAME:$PASSWORD -k"

# Test OpenSearch connection
echo "Testing OpenSearch connection to $OPENSEARCH_URL..."
RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" $OPENSEARCH_URL $CREDENTIALS)

if [ "$RESPONSE" != "200" ]; then
    echo "Error: Failed to connect to OpenSearch (HTTP $RESPONSE)"
    exit "$REJECTED"
fi

echo "Successfully connected to OpenSearch"

# Define JSON directory based on version
JSON_DIR="./opensearch/$VERSION"
MANIFEST="$JSON_DIR/templates.list"

# Check if version directory exists
if [ ! -d "$JSON_DIR" ]; then
    echo "Error: The index template directory $JSON_DIR of version $VERSION does not exist"
    exit "$REJECTED"
fi

if [ ! -f "$MANIFEST" ]; then
    echo "Error: Template manifest $MANIFEST does not exist"
    exit "$REJECTED"
fi

KEYS=()
VALUES=()

# Load and validate the complete version manifest before changing OpenSearch.
while read -r pattern json_file extra; do
    if [[ -z "$pattern" || "$pattern" == \#* ]]; then
        continue
    fi
    if [[ -z "$json_file" || -n "$extra" ]]; then
        echo "Error: Invalid template manifest entry: $pattern $json_file $extra"
        exit "$REJECTED"
    fi

    json_path="$JSON_DIR/$json_file"
    if [ ! -f "$json_path" ]; then
        echo "Error: Template file $json_path does not exist"
        exit "$REJECTED"
    fi
    if ! jq empty "$json_path" >/dev/null 2>&1; then
        echo "Error: Template file $json_path is not valid JSON"
        exit "$REJECTED"
    fi

    KEYS+=("$pattern")
    VALUES+=("$json_file")
done < "$MANIFEST"

if [ "${#KEYS[@]}" -eq 0 ]; then
    echo "Error: Template manifest $MANIFEST does not contain any templates"
    exit "$REJECTED"
fi

# Number of priorities reserved for a single version, see the priority computation below.
PRIORITY_BAND=100

if [ "${#KEYS[@]}" -gt "$PRIORITY_BAND" ]; then
    echo "Error: Version $VERSION ships ${#KEYS[@]} templates but only $PRIORITY_BAND priorities are reserved per version"
    exit "$REJECTED"
fi


# Function to create composable index template
create_composable_template() {
    local pattern=$1
    local json_file=$2
    local json_path="$JSON_DIR/$json_file"
    local priority=$3

    # Check if JSON template file exists
    if [ ! -f "$json_path" ]; then
        echo "Error: Template file $json_path does not exist"
        return 1
    fi

    local template_name="${pattern}_template_$VERSION"

    # Check if template already exists
    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" \
        -X GET "$OPENSEARCH_URL/_index_template/$template_name" \
        $CREDENTIALS)

    if [ "$RESPONSE" == "200" ]; then
        echo "Info: Index template $template_name already exists"
        return 0
    fi

    # Create the index template
    echo "Creating composable index template: $template_name using $json_file"

    # Build the full template JSON
    TEMP_JSON=$(mktemp)
    cat <<EOF > "$TEMP_JSON"
{
  "index_patterns": ["*${pattern}*"],
  "priority": ${priority},
  "template": $(cat "$json_path")
}
EOF
    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" \
        -X POST "$OPENSEARCH_URL/_index_template/$template_name" \
        $CREDENTIALS \
        -H "Content-Type: application/json" \
        --data-binary "@$TEMP_JSON")

    # Cleanup temp file
    rm -f "$TEMP_JSON"

    if [ "$RESPONSE" != "200" ] && [ "$RESPONSE" != "201" ]; then
        echo "Error: Failed to create index template (HTTP $RESPONSE)"
        return 1
    fi

    echo "Successfully created composable index template: $template_name"
    return 0
}

# Main processing
ERROR_OCCURRED=0

# Create composable templates for each pattern
# Each version owns a band of 100 priorities so that a later version always outranks an earlier one
# no matter how many templates it ships. Bands must stay wider than the largest bundle, otherwise
# two versions could assign the same priority to the same index pattern and OpenSearch would reject
# the request.
NUM="${VERSION//[!0-9]/}"
priority=$((10000 + NUM * PRIORITY_BAND))
for i in "${!KEYS[@]}"; do
    pattern="${KEYS[$i]}"
    json_file="${VALUES[$i]}"
    if ! create_composable_template "$pattern" "$json_file" "$priority"; then
        ERROR_OCCURRED=1
    fi
    let "priority+=1"
done

echo "Index template creation completed with status: $ERROR_OCCURRED"
exit "$ERROR_OCCURRED"
