VERSION=$1
OPENSEARCH_URL=$2
USERNAME=$3
PASSWORD=$4

# Prepare credentials for curl
CREDENTIALS="-u $USERNAME:$PASSWORD -k"

# Test OpenSearch connection
echo "Testing OpenSearch connection to $OPENSEARCH_URL..."
RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" $OPENSEARCH_URL $CREDENTIALS)

if [ "$RESPONSE" != "200" ]; then
    echo "Error: Failed to connect to OpenSearch (HTTP $RESPONSE)"
    exit 1
fi

echo "Successfully connected to OpenSearch"

JSON_DIR="./opensearch/$VERSION"
MANIFEST="$JSON_DIR/templates.list"

TEMPLATE_NAMES=()

if [ -f "$MANIFEST" ]; then
    while read -r pattern json_file extra; do
        if [[ -z "$pattern" || "$pattern" == \#* ]]; then
            continue
        fi
        if [[ -z "$json_file" || -n "$extra" ]]; then
            echo "Error: Invalid template manifest entry: $pattern $json_file $extra"
            exit 1
        fi
        TEMPLATE_NAMES+=("${pattern}_template_$VERSION")
    done < "$MANIFEST"

    if [ "${#TEMPLATE_NAMES[@]}" -eq 0 ]; then
        echo "Error: Template manifest $MANIFEST does not contain any templates"
        exit 1
    fi
else
    # The bundle of this version is not shipped locally any more: the directory was pruned, the
    # distribution was downgraded, or the version was created by hand. Discover the templates from
    # OpenSearch instead, otherwise such a version could never be removed and every subsequent
    # upgrade would fail on it.
    echo "Info: Template manifest $MANIFEST does not exist, discovering templates from OpenSearch"

    DISCOVERED=$(curl -s -X GET \
        "$OPENSEARCH_URL/_index_template/*_entity_index_template_$VERSION" \
        $CREDENTIALS | jq -r '.index_templates[]?.name')

    while read -r template_name; do
        if [[ -n "$template_name" ]]; then
            TEMPLATE_NAMES+=("$template_name")
        fi
    done <<< "$DISCOVERED"

    if [ "${#TEMPLATE_NAMES[@]}" -eq 0 ]; then
        echo "Warning: No index templates of version $VERSION found in OpenSearch, nothing to delete"
        exit 0
    fi
fi

# Function to delete index template
delete_index_template() {
    local template_name=$1

    # Check if template exists
    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" \
        -X GET "$OPENSEARCH_URL/_index_template/$template_name" \
        $CREDENTIALS)

    if [ "$RESPONSE" != "200" ]; then
        echo "Warning: Index template $template_name does not exist"
        return 0
    fi

    # Delete the index template
    echo "Deleting index template: $template_name"

    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" \
        -X DELETE "$OPENSEARCH_URL/_index_template/$template_name" \
        $CREDENTIALS)

    if [ "$RESPONSE" != "200" ]; then
        echo "Error: Failed to delete index template (HTTP $RESPONSE)"
        return 1
    fi

    echo "Successfully deleted index template: $template_name"
    return 0
}

# Main processing
ERROR_OCCURRED=0

# Delete all templates defined in the version manifest
for template_name in "${TEMPLATE_NAMES[@]}"; do
    if ! delete_index_template "$template_name"; then
        ERROR_OCCURRED=1
    fi
done

# Final status message
if [ "$ERROR_OCCURRED" -eq 0 ]; then
    echo ""
    echo "All index templates deleted successfully!"
    exit 0
else
    echo ""
    echo "Error: Some index templates could not be deleted"
    exit 1
fi
