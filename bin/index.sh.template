#

cd "$(dirname "$0")"
# Define paths to the scripts
CREATE_SCRIPT="opensearch/create_indices_template.sh"
DELETE_SCRIPT="opensearch/delete_indices_template.sh"

# Exit code used by CREATE_SCRIPT when it refuses a version before touching OpenSearch. Any other
# non-zero status means part of the bundle may already be installed.
CREATE_REJECTED=2

# Gravitino request state. These globals let OAuth token refreshes performed inside a request remain
# available to subsequent requests in the same rebuild command.
GRAVITINO_AUTH_MODE="none"
GRAVITINO_HTTP_CODE=""
GRAVITINO_RESPONSE_BODY=""

# Show usage information
show_usage() {
    cat <<EOF
Usage: $0 {init|upgrade|delete|version|rebuild|show} [version] [options]
Options:
  --opensearch_uri=OPENSEARCH_URI       OpenSearch connection URI
  --username=USERNAME                   OpenSearch username
  --password=PASSWORD                   OpenSearch password
  --gravitino_uri=GRAVITINO_URI         Gravitino server connection URI
  --gravitino_username=USERNAME         Gravitino Basic Auth username
  --gravitino_password=PASSWORD         Gravitino Basic Auth password
  --gravitino_token=TOKEN               Gravitino OAuth bearer token
  --gravitino_oauth_token_uri=URI        Gravitino OAuth token endpoint URI
  --gravitino_oauth_client_id=CLIENT_ID  Gravitino OAuth client ID
  --gravitino_oauth_client_secret=SECRET Gravitino OAuth client secret
  --gravitino_oauth_scope=SCOPE          Optional Gravitino OAuth scope
  --help                                Show this help message
EOF
    exit 1
}

# Check if required scripts exist
check_required_scripts() {
    if [[ ! -f "$CREATE_SCRIPT" ]] || [[ ! -f "$DELETE_SCRIPT" ]]; then
        echo "Error: Required scripts not found in the current directory."
        exit 1
    fi
}

check_jq() {
    if ! command -v jq &> /dev/null; then
        echo "Error: jq is not installed. Please install jq to parse JSON responses."
        echo "  Ubuntu/Debian: sudo apt-get install jq"
        exit 1
    fi
}

# Load OpenSearch configuration from environment variable or config file
load_config() {
    if [[ -z "$GRAVITINO_HOME" ]] || [[ ! -d "$GRAVITINO_HOME" ]]; then
        script_dir="$(pwd)"
        if [[ -f "$script_dir/gravitino.sh" ]]; then
            GRAVITINO_HOME="$(dirname "$script_dir")"
            echo "[INFO] Inferred GRAVITINO_HOME as $GRAVITINO_HOME"
        fi
    fi

    if [[ -n "$GRAVITINO_HOME" ]] && [[ -d "$GRAVITINO_HOME" ]]; then
        local conf_file="$GRAVITINO_HOME/conf/gravitino.conf"
        if [[ -f "$conf_file" ]]; then
            SEARCH_STORAGE=$(grep '^gravitino.datastrato.search.storage.impl' "$conf_file" | cut -d '=' -f2- | xargs)
            if [[ "$SEARCH_STORAGE" != "opensearch" ]]; then
                echo "Search storage is not OpenSearch, ignore the command"
                exit 1;
            fi

            OPENSEARCH_URL=$(grep '^gravitino.datastrato.search.opensearch.url' "$conf_file" | cut -d '=' -f2- | xargs)
            USERNAME=$(grep '^gravitino.datastrato.search.opensearch.username' "$conf_file" | cut -d '=' -f2- | xargs)
            PASSWORD=$(grep '^gravitino.datastrato.search.opensearch.password' "$conf_file" | cut -d '=' -f2- | xargs)
            GRAVITINO_URI="http://127.0.0.1:$(grep '^gravitino.server.webserver.httpPort' "$conf_file" | cut -d '=' -f2- | xargs)"
            if [[ -z "$GRAVITINO_OAUTH_TOKEN_URI" ]]; then
                local oauth_server_uri
                local oauth_token_path
                oauth_server_uri=$(grep '^gravitino.authenticator.oauth.serverUri' "$conf_file" | cut -d '=' -f2- | xargs)
                oauth_token_path=$(grep '^gravitino.authenticator.oauth.tokenPath' "$conf_file" | cut -d '=' -f2- | xargs)
                if [[ -n "$oauth_server_uri" ]] && [[ -n "$oauth_token_path" ]]; then
                    GRAVITINO_OAUTH_TOKEN_URI="${oauth_server_uri%/}/${oauth_token_path#/}"
                fi
            fi
            echo "[INFO] Loaded OpenSearch config from $conf_file"
        else
            echo "[WARN] Config file not found: $conf_file. Skipping OpenSearch config init."
        fi
    fi
}

# Parse command line arguments
parse_arguments() {
    for arg in "$@"; do
        case $arg in
            --opensearch_uri=*) OPENSEARCH_URL="${arg#*=}" ;;
            --username=*) USERNAME="${arg#*=}" ;;
            --password=*) PASSWORD="${arg#*=}" ;;
            --gravitino_uri=*) GRAVITINO_URI="${arg#*=}" ;;
            --gravitino_username=*) GRAVITINO_USERNAME="${arg#*=}" ;;
            --gravitino_password=*) GRAVITINO_PASSWORD="${arg#*=}" ;;
            --gravitino_token=*) GRAVITINO_TOKEN="${arg#*=}" ;;
            --gravitino_oauth_token_uri=*) GRAVITINO_OAUTH_TOKEN_URI="${arg#*=}" ;;
            --gravitino_oauth_client_id=*) GRAVITINO_OAUTH_CLIENT_ID="${arg#*=}" ;;
            --gravitino_oauth_client_secret=*) GRAVITINO_OAUTH_CLIENT_SECRET="${arg#*=}" ;;
            --gravitino_oauth_scope=*) GRAVITINO_OAUTH_SCOPE="${arg#*=}" ;;
            --help) show_usage ;;
            *) VERSION="$arg" ;;
        esac
    done
}

# Validate required parameters
validate_parameters() {
    if [[ -z "$OPENSEARCH_URL" ]] || [[ -z "$USERNAME" ]] || [[ -z "$PASSWORD" ]]; then
        echo "Error: Missing required parameters (opensearch_uri, username, or password). or GRAVITINO_HOME not set."
        show_usage
    fi

}

validate_version() {
    if [[ -z "$VERSION" ]]; then
        echo "Error: Missing required parameter version."
        show_usage
    fi
}

# Test OpenSearch connection
test_connection() {
    local credentials="-u $USERNAME:$PASSWORD -k"
    echo "Testing OpenSearch connection to $OPENSEARCH_URL..."
    local response=$(curl -s -o /dev/null -w "%{http_code}" "$OPENSEARCH_URL" $credentials)
    if [[ "$response" == "200" ]]; then
        echo "OpenSearch is reachable."
    else
        echo "Error: Failed to connect to OpenSearch (HTTP $response)."
        exit 1
    fi
}

print_index_template_version() {
    echo "Index version on OpenSearch:"

    local response=$(curl -s -k -u "$USERNAME:$PASSWORD" "$OPENSEARCH_URL/_index_template")
    local http_code=$(curl -s -o /dev/null -w "%{http_code}" -k -u "$USERNAME:$PASSWORD" "$OPENSEARCH_URL/_index_template")

    if [[ "$http_code" -ne 200 ]]; then
        echo "Error: Failed to fetch index templates (HTTP $http_code)."
        return 1
    fi

    echo "$response" \
    | jq -r '.index_templates[].name' \
    | sed -E 's/_entity_index_template_([a-zA-Z0-9]+)$/_entity_index \1/' \
    || echo "Error: Failed to parse index template list."
}

print_index() {
  echo "Index alias on OpenSearch:"
  echo -e "Alias\tIndex\tTemplate"

  curl -s -k -u "$USERNAME:$PASSWORD" "$OPENSEARCH_URL/_cat/aliases?v" |
    grep "_entity_index" |
    awk '{print $1, $2}' |
    while read -r alias index; do
      response=$(curl -s -k -u "$USERNAME:$PASSWORD" "$OPENSEARCH_URL/_index_template")
      templates=$(echo "$response" | jq -c '.index_templates[]')

      matched_template=""

      while IFS= read -r template; do
        name=$(echo "$template" | jq -r '.name')
        patterns=$(echo "$template" | jq -r '.index_template.index_patterns[]')

        for pattern in $patterns; do
          regex="^${pattern//\*/.*}$"
          if [[ "$index" =~ $regex ]]; then
            matched_template="$name"
            break 2
          fi
        done
      done <<< "$templates"

      echo -e "$alias\t$index\t$matched_template"
    done | column -t -s $'\t'

  echo ""
  echo "Index on OpenSearch:"
  curl -s -k -u "$USERNAME:$PASSWORD" "$OPENSEARCH_URL/_cat/indices?v" | grep -E '^health|_entity_index_'
}

get_all_index_template_versions() {
    local response=$(curl -s -k -u "$USERNAME:$PASSWORD" "$OPENSEARCH_URL/_index_template")
    local http_code=$(curl -s -o /dev/null -w "%{http_code}" -k -u "$USERNAME:$PASSWORD" "$OPENSEARCH_URL/_index_template")

    # Diagnostics go to stderr: callers capture stdout and treat every line as a version name.
    if [[ "$http_code" -ne 200 ]]; then
        echo "Error: Failed to fetch index templates (HTTP $http_code)." >&2
        return 1
    fi

    local names
    if ! names=$(echo "$response" | jq -r '.index_templates[].name' 2>/dev/null); then
        echo "Error: Failed to parse index template list." >&2
        return 1
    fi

    printf '%s\n' "$names" \
    | sed -En 's/.*_entity_index_template_([a-zA-Z0-9]+)$/\1/p' \
    | sort -u
}

escape_curl_config_value() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\t'/\\t}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

write_oauth_curl_config() {
  printf 'data-urlencode = "grant_type=client_credentials"\n'
  printf 'data-urlencode = "client_id=%s"\n' \
    "$(escape_curl_config_value "$GRAVITINO_OAUTH_CLIENT_ID")"
  printf 'data-urlencode = "client_secret=%s"\n' \
    "$(escape_curl_config_value "$GRAVITINO_OAUTH_CLIENT_SECRET")"
  if [[ -n "$GRAVITINO_OAUTH_SCOPE" ]]; then
    printf 'data-urlencode = "scope=%s"\n' \
      "$(escape_curl_config_value "$GRAVITINO_OAUTH_SCOPE")"
  fi
}

write_gravitino_auth_curl_config() {
  case "$GRAVITINO_AUTH_MODE" in
    provided_token|oauth_client_credentials)
      printf 'header = "Authorization: Bearer %s"\n' \
        "$(escape_curl_config_value "$GRAVITINO_TOKEN")"
      ;;
    basic)
      printf 'user = "%s:%s"\n' \
        "$(escape_curl_config_value "$GRAVITINO_USERNAME")" \
        "$(escape_curl_config_value "$GRAVITINO_PASSWORD")"
      ;;
  esac
}

fetch_gravitino_oauth_token() {
  local token_response
  if ! token_response=$(write_oauth_curl_config | curl --config - -sS -w $'\n%{http_code}' \
      -X POST \
      -H "Accept: application/json" \
      -H "Content-Type: application/x-www-form-urlencoded" \
      "$GRAVITINO_OAUTH_TOKEN_URI"); then
    echo "Error: Failed to request an OAuth token for Gravitino."
    return 1
  fi

  local token_http_code="${token_response##*$'\n'}"
  local token_body="${token_response%$'\n'*}"
  if [[ "$token_http_code" != 2* ]]; then
    local oauth_error
    oauth_error=$(printf '%s' "$token_body" \
      | jq -r 'if type == "object" then .error_description // .error // empty else empty end' \
        2>/dev/null)
    echo "Error: OAuth token request failed (HTTP $token_http_code)."
    if [[ -n "$oauth_error" ]]; then
      echo "OAuth error: $oauth_error"
    fi
    return 1
  fi

  local access_token
  if ! access_token=$(printf '%s' "$token_body" | jq -er '
      select(
        (.access_token | type) == "string"
        and (.access_token | length) > 0
        and ((.token_type // "") | ascii_downcase) == "bearer")
      | .access_token' 2>/dev/null); then
    echo "Error: OAuth token response did not contain a valid bearer access token."
    return 1
  fi

  GRAVITINO_TOKEN="$access_token"
}

configure_gravitino_auth() {
  GRAVITINO_AUTH_MODE="none"

  if [[ -n "$GRAVITINO_TOKEN" ]]; then
    if [[ -n "$GRAVITINO_OAUTH_CLIENT_ID" ]] \
        && [[ -n "$GRAVITINO_OAUTH_CLIENT_SECRET" ]]; then
      echo "[WARN] GRAVITINO_TOKEN takes precedence over OAuth client credentials and cannot be refreshed."
    fi
    GRAVITINO_AUTH_MODE="provided_token"
    return 0
  fi

  if [[ -n "$GRAVITINO_OAUTH_CLIENT_ID" ]] \
      && [[ -n "$GRAVITINO_OAUTH_CLIENT_SECRET" ]]; then
    local missing=()
    [[ -z "$GRAVITINO_OAUTH_TOKEN_URI" ]] && missing+=("gravitino_oauth_token_uri")
    if [[ "${#missing[@]}" -gt 0 ]]; then
      echo "Error: Missing OAuth parameters: ${missing[*]}."
      return 1
    fi

    GRAVITINO_AUTH_MODE="oauth_client_credentials"
    fetch_gravitino_oauth_token
    return $?
  fi

  if [[ -n "$GRAVITINO_USERNAME" ]] || [[ -n "$GRAVITINO_PASSWORD" ]]; then
    if [[ -z "$GRAVITINO_USERNAME" ]] || [[ -z "$GRAVITINO_PASSWORD" ]]; then
      echo "Error: Both gravitino_username and gravitino_password are required for Basic Auth."
      return 1
    fi
    GRAVITINO_AUTH_MODE="basic"
  fi
}

gravitino_request() {
  local method="$1"
  local uri="$2"
  shift 2

  local response
  if ! response=$(write_gravitino_auth_curl_config \
      | curl --config - -sS -w $'\n%{http_code}' \
      -X "$method" "$@" "$uri"); then
    return 1
  fi

  GRAVITINO_HTTP_CODE="${response##*$'\n'}"
  GRAVITINO_RESPONSE_BODY="${response%$'\n'*}"
  if [[ "$GRAVITINO_HTTP_CODE" == "401" ]] \
      && [[ "$GRAVITINO_AUTH_MODE" == "oauth_client_credentials" ]]; then
    echo "[INFO] Gravitino rejected the OAuth token. Refreshing it and retrying once."
    if ! fetch_gravitino_oauth_token; then
      return 1
    fi
    if ! response=$(write_gravitino_auth_curl_config \
        | curl --config - -sS -w $'\n%{http_code}' \
        -X "$method" "$@" "$uri"); then
      return 1
    fi
    GRAVITINO_HTTP_CODE="${response##*$'\n'}"
    GRAVITINO_RESPONSE_BODY="${response%$'\n'*}"
  fi
}

rebuild_index() {
  if [[ -z "$GRAVITINO_URI" ]]; then
    echo "Error: Missing required parameter gravitino_uri."
    show_usage
    return 1
  fi

  if ! configure_gravitino_auth; then
    return 1
  fi

  if ! gravitino_request GET "$GRAVITINO_URI/api/metalakes"; then
    echo "Error: Failed to fetch metalakes from Gravitino."
    return 1
  fi

  local list_http_code="$GRAVITINO_HTTP_CODE"
  local list_body="$GRAVITINO_RESPONSE_BODY"
  if [[ "$list_http_code" != 2* ]]; then
    echo "Error: Failed to fetch metalakes from Gravitino (HTTP $list_http_code)."
    if [[ -n "$list_body" ]]; then
      echo "Response: $list_body"
    else
      echo "Response: <empty>"
    fi
    return 1
  fi

  if ! printf '%s' "$list_body" | jq -e '
      type == "object"
      and ((.metalakes == null) or ((.metalakes | type) == "array"))
      and ([.metalakes[]? | (.name | type) == "string"] | all)' > /dev/null 2>&1; then
    echo "Error: Failed to parse the metalakes response from Gravitino."
    if [[ -n "$list_body" ]]; then
      echo "Response: $list_body"
    else
      echo "Response: <empty>"
    fi
    return 1
  fi

  local metalakes
  metalakes=$(printf '%s' "$list_body" | jq -r '.metalakes[]?.name')
  if [[ -z "$metalakes" ]]; then
    echo "No metalakes found. Nothing to rebuild."
    return 0
  fi

  local failed=0

  while IFS= read -r name; do
    if [[ -z "$name" ]]; then
      continue
    fi
    echo "Rebuilding search index for metalake: $name"
    if ! gravitino_request POST "$GRAVITINO_URI/api/search/rebuild/metalakes/$name" \
        -H "Content-Type: application/json"; then
      echo "Failed to rebuild index for metalake $name: request failed."
      ((failed++))
      echo
      continue
    fi

    local rebuild_http_code="$GRAVITINO_HTTP_CODE"
    local rebuild_body="$GRAVITINO_RESPONSE_BODY"

    if [[ "$rebuild_http_code" == 2* ]]; then
      echo "Success rebuild index for metalake $name"
    else
      echo "Failed to rebuild index for metalake $name (HTTP $rebuild_http_code):"
      if [[ -n "$rebuild_body" ]]; then
        echo "$rebuild_body"
      else
        echo "<empty response>"
      fi
      ((failed++))
    fi
    echo
  done <<< "$metalakes"

  if [[ "$failed" -gt 0 ]]; then
    echo "Completed with $failed failure(s)."
    return 1
  else
    echo "All metalake indexes rebuilt successfully."
  fi
}

# Main logic
main() {
    if [[ $# -lt 1 ]]; then
        echo "Error: No operation specified (init/upgrade/delete/version/show/rebuild)"
        show_usage
        exit 1
    fi

    OPERATION="$1"
    shift

    check_jq
    check_required_scripts
    load_config
    parse_arguments "$@"

    case "$OPERATION" in
        init)
            shift
            validate_parameters
            test_connection

            if ! existVersions=$(get_all_index_template_versions); then
              echo "Error: Failed to list the index template versions already installed."
              exit 1
            fi
            if [[ -n "$existVersions" ]]; then
              echo "Info: Existing index templates found with versions: $existVersions"
              echo "Info: Run '$0 upgrade <version>' to reconcile or upgrade them."
              exit 1
            fi

            if [[ -z "$VERSION" ]]; then
              VERSION=$(ls -d opensearch/v[0-9]* 2>/dev/null | sort -t 'v' -k2,2n | tail -1 | sed 's#.*/##')
              if [[ -z "$VERSION" ]]; then
                echo "Error: No version specified and no version directories found in opensearch"
                exit 1
              fi
            fi


            bash "$CREATE_SCRIPT" $VERSION $OPENSEARCH_URL "$USERNAME" "$PASSWORD"
            ;;

        upgrade)
            shift
            validate_parameters
            validate_version
            test_connection
            if ! existVersions=$(get_all_index_template_versions); then
              echo "Error: Failed to list the index template versions already installed."
              exit 1
            fi

            if echo "$existVersions" | grep -qx "$VERSION"; then
              # Retry creation to repair a previous attempt that installed only part of the
              # immutable version bundle. Existing templates are never rewritten.
              echo "Index version $VERSION already exists, verifying its templates..."
            else
              echo "Creating index template with version $VERSION..."
            fi

            bash "$CREATE_SCRIPT" "$VERSION" "$OPENSEARCH_URL" "$USERNAME" "$PASSWORD"
            CREATE_STATUS=$?
            if [[ "$CREATE_STATUS" -eq "$CREATE_REJECTED" ]]; then
              echo "Error: Version $VERSION was rejected before any template was written. Existing templates were preserved."
              exit 1
            elif [[ "$CREATE_STATUS" -ne 0 ]]; then
              echo "Error: Version $VERSION was only partially created and is already active for new indices."
              echo "Error: Previous templates were preserved; fix the failure and re-run '$0 upgrade $VERSION' to complete the bundle."
              exit 1
            fi

            DELETE_FAILED=0
            while read -r existingVersion; do
              if [[ -z "$existingVersion" || "$existingVersion" == "$VERSION" ]]; then
                continue
              fi
              echo "Deleting previous index templates with version $existingVersion..."
              if ! bash "$DELETE_SCRIPT" "$existingVersion" "$OPENSEARCH_URL" "$USERNAME" "$PASSWORD"; then
                DELETE_FAILED=1
              fi
            done <<< "$existVersions"

            if [[ "$DELETE_FAILED" -ne 0 ]]; then
              echo "Error: Version $VERSION was created, but some previous templates could not be deleted."
              exit 1
            fi
            ;;

        delete)
            shift
            validate_parameters
            validate_version
            test_connection
            bash "$DELETE_SCRIPT" $VERSION $OPENSEARCH_URL "$USERNAME" "$PASSWORD"
            ;;

        version)
            shift
            validate_parameters
            test_connection
            echo ""
            print_index_template_version
            ;;

        rebuild)
            shift
            echo ""
            rebuild_index
            ;;

        show)
            shift
            validate_parameters
            test_connection
            echo ""
            print_index
            ;;

        *)
            show_usage
            ;;
    esac
}

main "$@"
